generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id(default: cuid()) @db.VarChar(255)
  sku         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  categoryId  String?  @db.VarChar(255)
  brandId     String?  @db.VarChar(255)
  price       Decimal  @db.Decimal(12, 2)
  cost        Decimal  @db.Decimal(12, 2)
  stockQty    Int      @default(0)
  lowStock    Int      @default(5)
  active      Boolean  @default(true)
  imageUrl    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand    Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  saleItems SaleItem[]
  receivingItems ReceivingItem[]
  stocktakeItems StocktakeItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([sku])
}

model Category {
  id        String   @id(default: cuid()) @db.VarChar(255)
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(100)
  active    Boolean  @default(true)
  products  Product[]

  @@index([slug])
}

model Brand {
  id      String   @id(default: cuid()) @db.VarChar(255)
  name    String   @db.VarChar(100)
  slug    String   @unique @db.VarChar(100)
  active  Boolean  @default(true)
  products Product[]

  @@index([slug])
}

model ProductVariant {
  id        String   @id(default: cuid()) @db.VarChar(255)
  productId String   @db.VarChar(255)
  sku       String   @unique @db.VarChar(100)
  name      String   @db.VarChar(255)
  price     Decimal  @db.Decimal(12, 2)
  cost      Decimal  @db.Decimal(12, 2)
  stockQty  Int      @default(0)
  active    Boolean  @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]

  @@index([productId])
  @@index([sku])
}

model Customer {
  id          String   @id(default: cuid()) @db.VarChar(255)
  name        String   @db.VarChar(255)
  type        String   @default("Individual") @db.VarChar(50)
  phone       String?  @db.VarChar(50)
  email       String?  @db.VarChar(255)
  address     String?  @db.Text
  tin         String?  @db.VarChar(100)
  tags        String[] @default([])
  creditOwed  Decimal  @default(0) @db.Decimal(12, 2)
  storeCredit Decimal  @default(0) @db.Decimal(12, 2)
  lastPurchase DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales       Sale[]
  layaways    Layaway[]
  credits     CustomerCredit[]

  @@index([phone])
  @@index([email])
  @@index([active])
}

model Sale {
  id             String   @id(default: cuid()) @db.VarChar(255)
  ref            String   @unique @db.VarChar(100)
  customerId     String?  @db.VarChar(255)
  channel        String   @default("In-store") @db.VarChar(50)
  paymentMethod  String   @db.VarChar(100)
  subtotal       Decimal  @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  tax            Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  paid           Decimal  @default(0) @db.Decimal(12, 2)
  status         String   @default("completed") @db.VarChar(50)
  date           DateTime @default(now())
  location       String   @default("Shop") @db.VarChar(100)
  notes          String?  @db.Text

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    SaleItem[]

  @@index([customerId])
  @@index([date])
  @@index([status])
  @@index([ref])
}

model SaleItem {
  id        String   @id(default: cuid()) @db.VarChar(255)
  saleId    String   @db.VarChar(255)
  variantId String?  @db.VarChar(255)
  productId String?  @db.VarChar(255)
  name      String   @db.VarChar(255)
  sku       String   @db.VarChar(100)
  qty       Int
  price     Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)

  sale     Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([variantId])
  @@index([productId])
}

model Supplier {
  id          String   @id(default: cuid()) @db.VarChar(255)
  name        String   @db.VarChar(255)
  contact     String?  @db.VarChar(255)
  phone       String?  @db.VarChar(50)
  email       String?  @db.VarChar(255)
  country     String?  @db.VarChar(100)
  currency    String   @default("MWK") @db.VarChar(10)
  balanceOwed Decimal  @default(0) @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
  receivings  Receiving[]

  @@index([active])
}

model Order {
  id           String   @id(default: cuid()) @db.VarChar(255)
  ref          String   @unique @db.VarChar(100)
  supplierId   String   @db.VarChar(255)
  status       String   @default("draft") @db.VarChar(50)
  totalCost    Decimal  @default(0) @db.Decimal(12, 2)
  projectedRevenue Decimal @default(0) @db.Decimal(12, 2)
  orderedAt    DateTime @default(now())
  receivedAt   DateTime?
  notes        String?  @db.Text

  supplier Supplier @relation(fields: [supplierId], references: [id])
  items    OrderItem[]
  receiving Receiving[]

  @@index([supplierId])
  @@index([status])
  @@index([ref])
}

model OrderItem {
  id        String   @id(default: cuid()) @db.VarChar(255)
  orderId   String   @db.VarChar(255)
  productId String?  @db.VarChar(255)
  variantId String?  @db.VarChar(255)
  name      String   @db.VarChar(255)
  sku       String   @db.VarChar(100)
  qtyOrdered Int
  qtyReceived Int   @default(0)
  unitCost  Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Receiving {
  id        String   @id(default: cuid()) @db.VarChar(255)
  ref       String   @unique @db.VarChar(100)
  supplierId String? @db.VarChar(255)
  orderId   String?  @db.VarChar(255)
  source    String   @default("manual") @db.VarChar(50)
  date      DateTime @default(now())
  notes     String?  @db.Text

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items    ReceivingItem[]

  @@index([supplierId])
  @@index([orderId])
  @@index([date])
  @@index([ref])
}

model ReceivingItem {
  id        String   @id(default: cuid()) @db.VarChar(255)
  receivingId String  @db.VarChar(255)
  productId String?  @db.VarChar(255)
  variantId String?  @db.VarChar(255)
  name      String   @db.VarChar(255)
  sku       String   @db.VarChar(100)
  qty       Int
  unitCost  Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)

  receiving Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([receivingId])
}

model Layaway {
  id          String   @id(default: cuid()) @db.VarChar(255)
  ref         String   @unique @db.VarChar(100)
  customerId  String   @db.VarChar(255)
  total       Decimal  @db.Decimal(12, 2)
  paid        Decimal  @default(0) @db.Decimal(12, 2)
  dueDate     DateTime
  status      String   @default("active") @db.VarChar(50)
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  payments LayawayPayment[]

  @@index([customerId])
  @@index([status])
  @@index([ref])
}

model LayawayPayment {
  id        String   @id(default: cuid()) @db.VarChar(255)
  layawayId String   @db.VarChar(255)
  amount    Decimal  @db.Decimal(12, 2)
  method    String   @db.VarChar(100)
  date      DateTime @default(now())

  layaway Layaway @relation(fields: [layawayId], references: [id], onDelete: Cascade)

  @@index([layawayId])
}

model CustomerCredit {
  id        String   @id(default: cuid()) @db.VarChar(255)
  customerId String  @db.VarChar(255)
  amount    Decimal  @db.Decimal(12, 2)
  type      String   @db.VarChar(50)
  date      DateTime @default(now())
  note      String?  @db.Text

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model Payment {
  id        String   @id(default: cuid()) @db.VarChar(255)
  txnId     String?  @db.VarChar(255)
  amount    Decimal  @db.Decimal(12, 2)
  method    String   @db.VarChar(100)
  date      DateTime @default(now())
  storeCreditUsed Boolean @default(false)

  @@index([txnId])
  @@index([date])
}

model Refund {
  id        String   @id(default: cuid()) @db.VarChar(255)
  saleId    String?  @db.VarChar(255)
  amount    Decimal  @db.Decimal(12, 2)
  reason    String?  @db.Text
  date      DateTime @default(now())

  sale Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([date])
}

model Transfer {
  id        String   @id(default: cuid()) @db.VarChar(255)
  ref       String   @unique @db.VarChar(100)
  fromLocation String @db.VarChar(100)
  toLocation String  @db.VarChar(100)
  status    String   @default("pending") @db.VarChar(50)
  date      DateTime @default(now())
  notes     String?  @db.Text

  @@index([status])
  @@index([ref])
}

model Stocktake {
  id        String   @id(default: cuid()) @db.VarChar(255)
  ref       String   @unique @db.VarChar(100)
  location  String   @db.VarChar(100)
  date      DateTime @default(now())
  status    String   @default("open") @db.VarChar(50)
  notes     String?  @db.Text

  items StocktakeItem[]

  @@index([status])
  @@index([ref])
}

model StocktakeItem {
  id        String   @id(default: cuid()) @db.VarChar(255)
  stocktakeId String @db.VarChar(255)
  productId String?  @db.VarChar(255)
  variantId String?  @db.VarChar(255)
  countedQty Int
  recordedQty Int

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([stocktakeId])
}

model Activity {
  id        String   @id(default: cuid()) @db.VarChar(255)
  activity  String   @db.VarChar(255)
  reference String?  @db.VarChar(255)
  location  String?  @db.VarChar(100)
  quantity  Int?
  when      DateTime @default(now())
  status    String   @default("ok") @db.VarChar(50)

  @@index([when])
}

model Cashbook {
  id            String   @id(default: cuid()) @db.VarChar(255)
  date          DateTime @default(now())
  direction     String   @db.VarChar(10)
  category      String   @db.VarChar(100)
  amount        Decimal  @db.Decimal(12, 2)
  method        String   @default("Cash") @db.VarChar(100)
  note          String?  @db.Text
  sourceTxnId   String?  @db.VarChar(255)

  @@index([date])
  @@index([direction])
}

model Expense {
  id        String   @id(default: cuid()) @db.VarChar(255)
  date      DateTime @default(now())
  category  String   @db.VarChar(100)
  amount    Decimal  @db.Decimal(12, 2)
  method    String   @default("Cash") @db.VarChar(100)
  note      String?  @db.Text

  @@index([date])
  @@index([category])
}

model Setting {
  id   String @id @default(cuid()) @db.VarChar(255)
  key  String @unique @db.VarChar(255)
  value String @db.Text
}

model Migration {
  id   String @id @default(cuid()) @db.VarChar(255)
  name String @unique @db.VarChar(255)
  appliedAt DateTime @default(now())
}
